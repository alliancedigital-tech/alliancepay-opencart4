{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ back }}"
           data-bs-toggle="tooltip"
           title="{{ button_back }}"
           class="btn btn-light">
          <i class="fas fa-reply"></i>
        </a>
      </div>
      <h1>
         {{ heading_title }}
      </h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item">
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid" id="alliance-page">
     {% if error_warning %}
      <div class="alert alert-danger" role="alert">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">

        </button>
      </div>
     {% endif %}
    {% if success %}
      <div class="alert alert-success" role="alert">
        <i class="fa fa-check-circle"></i> {{ success }}
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">

        </button>
       </div>
    {% endif %}
    <div class="card">
      <div class="row mb-3">
        <div class="form-text">
          {% if (is_error) %}
            <p>
              <span class="alliance-order-info-title">{{ text_msg_type }}</span>
              <span class="alliance-order-info-value">{{ msg_type }}</span>
            </p>
          {% else %}
              {% if (is_refund) %}
              <p>
                  <span class="alliance-order-info-title">{{ text_refund_status }}</span>
                  <span class="alliance-order-info-value alliance-order-info-value-refund">{{ text_refund_successful }}</span>
              </p>
              {% endif %}
            <p>
              <span class="alliance-order-info-title">{{ text_order_status }}</span>
              <span class="alliance-order-info-value">{{ order_status }}</span>
            </p>
            {% if has_currency_conversion %}
            <p>
              <span class="alliance-order-info-title">{{ text_amount_uah }}</span>
              <span class="alliance-order-info-value">{{ coin_amount_uah }}</span>
            </p>
            <p>
              <span class="alliance-order-info-title">{{ text_amount }} ({{ currency_name }}):</span>
              <span class="alliance-order-info-value">{{ coin_amount_currency }}</span>
            </p>
            {% else %}
            <p>
              <span class="alliance-order-info-title">{{ text_amount_uah }}</span>
              <span class="alliance-order-info-value">{{ coin_amount_uah }}</span>
            </p>
            {% endif %}
            <p>
              <span class="alliance-order-info-title">{{ text_ecom_order_id }}</span>
              <span class="alliance-order-info-value">{{ ecom_order_id }}</span>
            </p>
            <p>
               <span class="alliance-order-info-title">{{ text_status_url }}</span>
              <span class="alliance-order-info-value"><a href="{{ status_url }}" target="_blank">{{ status_url }}</a></span>
            </p>
            <p>
              <span class="alliance-order-info-title">{{ text_merchant_id }}</span>
              <span class="alliance-order-info-value">{{ merchant_id }}</span>
            </p>
            <p>
              <span class="alliance-order-info-title">{{ text_hpp_order_id }}</span>
              <span class="alliance-order-info-value">{{ hpp_order_id }}</span>
            </p>
            <p>
              <span class="alliance-order-info-title">{{ text_hpp_pay_type }}</span>
              <span class="alliance-order-info-value">{{ hpp_pay_type }}</span>
            </p>
            <p>
              <span class="alliance-order-info-title">{{ text_expired_order_date }}</span>
              <span class="alliance-order-info-value">{{ expired_order_date }}</span>
            </p>
            <p>
              <span class="alliance-order-info-title">{{ text_created_date }}</span>
               <span class="alliance-order-info-value">{{ create_date }}</span>
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .alliance-order-info-title {
    font-family: 'Arial', sans-serif;
    font-size: 18px;
    color: #333;
    line-height: 1.6;
    letter-spacing: 0.5px;
    text-align: justify;
    text-transform: capitalize;
    margin: 20px 0;
    padding: 10px;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .alliance-order-info-value {
    font-family: 'Arial', sans-serif;
    font-size: 15px;
    color: #333;
    line-height: 1.6;
    letter-spacing: 0.5px;
    text-align: justify;
    text-transform: capitalize;
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .alliance-order-info-value-refund {
      color: #ff1300;
  }
</style>
{{ footer }}

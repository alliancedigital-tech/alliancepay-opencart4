{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit"
          form="form-alliance-account"
          data-toggle="tooltip"
          title="{{ button_save }}"
          class="btn btn-primary">
          <i class="fa fa-save"></i>
        </button>

        <a href="{{ back }}"
          data-bs-toggle="tooltip"
          title="{{ button_back }}"
          class="btn btn-light">
          <i class="fas fa-reply"></i>
        </a>
      </div>
      <h1>
        {{ heading_title }}
      </h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item">
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid" id="alliance-page">
    {% if error_warning %}
      <div class="alert alert-danger" role="alert">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button"
          class="btn-close"
          data-bs-dismiss="alert"
          aria-label="Close">

        </button>
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success" role="alert">
        <i class="fa fa-check-circle"></i> {{ success }}
        <button type="button"
          class="btn-close"
          data-bs-dismiss="alert"
          aria-label="Close">

        </button>
      </div>
    {% endif %}
    <div class="card">
      <div class="card-header">
        <i class="fa fa-pencil"></i> {{ text_alliance_settings }}
      </div>
      <div class="card-body">
        <form id="form-alliance-account"
          class="row g-3 needs-validation"
          action="{{ url_action }}"
          method="post"
          enctype="multipart/form-data">
          <input type="hidden" name="action" value="save" />
          <h3 class="mb-3">
            {{ text_help_settings }}
          </h3>

          <h5 class="mb-3">
            {{ text_help_jwt }}
          </h5>
          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_url">{{ entry_api_url }}</label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-link fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_url"
                     id="payment_alliance_url"
                     value="{{ payment_alliance_url }}"
                     placeholder=""
                     class="form-control" />
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_jwt_param_x">
              {{ entry_param_x }}
            </label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-key fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_jwt_param_x"
                     id="payment_alliance_jwt_param_x"
                     value="{{ payment_alliance_jwt_param_x }}"
                     placeholder=""
                     class="form-control" />
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_jwt_param_y">
              {{ entry_param_y }}
            </label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-key fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_jwt_param_y"
                     id="payment_alliance_jwt_param_y"
                     value="{{ payment_alliance_jwt_param_y }}"
                     placeholder=""
                     class="form-control" />
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_jwt_param_d">
              {{ entry_param_d }}
            </label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-key fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_jwt_param_d"
                     id="payment_alliance_jwt_param_d"
                     value="{{ payment_alliance_jwt_param_d }}"
                     placeholder=""
                     class="form-control" />
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_service_code_id">
              {{ alliance_service_code_id_api_key }}
            </label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-code fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_service_code_id"
                     id="payment_alliance_service_code_id"
                     value="{{ payment_alliance_service_code_id }}"
                     placeholder=""
                     class="form-control" />
            </div>
            <div class="form-text">
              {{ help_service_code }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_merchant_id">
              {{ merchant_id_key }}
            </label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-user fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_merchant_id"
                     id="payment_alliance_merchant_id"
                     value="{{ payment_alliance_merchant_id }}"
                     placeholder=""
                     class="form-control" />
            </div>
            <div class="form-text">
               {{ help_merchant_id }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="input-hpp-type">{{ entry_hpp_type }}</label>
            <div class="input-group">
              <select name="payment_alliance_hpp_type" id="input-hpp-type" class="form-select" onchange="allianceTogglePreAuth(this.value)">
                <option value="" {{ payment_alliance_hpp_type is empty ? 'selected="selected"' : '' }}></option>
                <option value="PURCHASE" {{ payment_alliance_hpp_type == 'PURCHASE' ? 'selected="selected"' : '' }}>PURCHASE</option>
                <option value="A2A" {{ payment_alliance_hpp_type == 'A2A' ? 'selected="selected"' : '' }}>A2A</option>
                <option value="PREAUTH" {{ payment_alliance_hpp_type == 'PREAUTH' ? 'selected="selected"' : '' }}>PREAUTH</option>
              </select>
            </div>
            <div class="form-text">{{ help_hpp_type }}</div>
          </div>

          <div id="preauth-expdate-block" class="row mb-3" style="{{ payment_alliance_hpp_type == 'PREAUTH' ? '' : 'display:none' }}">
            <label class="form-label" for="input-preauth-exp-date">{{ entry_preauth_exp_date }}</label>
            <div class="input-group">
              <select name="payment_alliance_preauth_exp_date" id="input-preauth-exp-date" class="form-select">
                <option value="2h"  {{ payment_alliance_preauth_exp_date == '2h'  ? 'selected="selected"' : '' }}>2 hours</option>
                <option value="4h"  {{ payment_alliance_preauth_exp_date == '4h'  ? 'selected="selected"' : '' }}>4 hours</option>
                <option value="6h"  {{ payment_alliance_preauth_exp_date == '6h'  ? 'selected="selected"' : '' }}>6 hours</option>
                <option value="12h" {{ payment_alliance_preauth_exp_date == '12h' ? 'selected="selected"' : '' }}>12 hours</option>
                <option value="1d"  {{ payment_alliance_preauth_exp_date == '1d'  ? 'selected="selected"' : '' }}>1 day</option>
                <option value="2d"  {{ payment_alliance_preauth_exp_date == '2d'  ? 'selected="selected"' : '' }}>2 days</option>
                <option value="7d"  {{ payment_alliance_preauth_exp_date == '7d'  ? 'selected="selected"' : '' }}>7 days</option>
                <option value="14d" {{ payment_alliance_preauth_exp_date == '14d' ? 'selected="selected"' : '' }}>14 days</option>
                <option value="28d" {{ payment_alliance_preauth_exp_date == '28d' ? 'selected="selected"' : '' }}>28 days</option>
              </select>
            </div>
            <div class="form-text">{{ help_preauth_exp_date }}</div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_fail_url">
              {{ entry_fail_url }}
            </label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-link fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_fail_url"
                     id="payment_alliance_fail_url"
                     value="{{ payment_alliance_fail_url }}"
                     placeholder=""
                     class="form-control" />
            </div>
            <div class="form-text">
              {{ help_fail_url }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label" for="payment_alliance_success_url">
              {{ entry_success_url }}
            </label>
            <div class="input-group has-validation">
              <div class="input-group-text">
                <i class="fa fa-link fa-fw"></i>
              </div>
              <input type="text"
                     name="payment_alliance_success_url"
                     id="payment_alliance_success_url"
                     value="{{ payment_alliance_success_url }}"
                     placeholder=""
                     class="form-control" />
            </div>
            <div class="form-text">
               {{ help_success_url }}
            </div>
          </div>
          <div class="row mb-3">
            <label class="form-label" for="input-status">
              {{ entry_status }}
            </label>
            <div class="input-group has-validation">
              <select name="payment_alliance_status"
                id="input-status"
                class="form-select">
                {% if payment_alliance_status %}
                  <option value="1" selected="selected">
                    {{ text_enabled }}
                  </option>
                  <option value="0">
                    {{ text_disabled }}
                  </option>
                {% else %}
                  <option value="1">
                    {{ text_enabled }}
                  </option>
                  <option value="0" selected="selected">
                    {{ text_disabled }}
                  </option>
                {% endif %}
              </select>
            </div>
            {% if error_status %}
              <div class="invalid-feedback">
                 {{ error_status }}
              </div>
            {% endif %}
            <div class="form-text">
              {{ help_status }}
            </div>
          </div>

          <br />
          <h3 class="mb-3">
            {{ text_statuses }}
          </h3>
          <div class="form-text admin-statuses">
            {{ help_statuses }}
          </div>

          <div class="row mb-3">
            <label class="form-label">{{ entry_pending_status }}</label>
            <div class="input-group">
              <select name="payment_alliance_pending_status" class="form-select">
                {% for order_status in order_statuses %}
                  {% if
                    order_status.order_status_id
                      == payment_alliance_pending_status %}
                    <option value="{{ order_status.order_status_id }}"
                       selected="selected">
                      {{ order_status.name }}
                    </option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">
                      {{ order_status.name }}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-text">
              {{ help_pending_status }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label">{{ entry_error_status }}</label>
            <div class="input-group">
               <select name="payment_alliance_error_status" class="form-select">
                {% for order_status in order_statuses %}
                  {% if
                    order_status.order_status_id
                    == payment_alliance_error_status %}
                     <option value="{{ order_status.order_status_id }}"
                            selected="selected">
                      {{ order_status.name }}
                    </option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">
                      {{ order_status.name }}
                    </option>
                  {% endif %}
                 {% endfor %}
              </select>
            </div>
            <div class="form-text">
              {{ help_error_status }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label">{{ entry_paid_status }}</label>
            <div class="input-group">
               <select name="payment_alliance_paid_status" class="form-select">
                {% for order_status in order_statuses %}
                  {% if
                    order_status.order_status_id
                      == payment_alliance_paid_status %}
                     <option value="{{ order_status.order_status_id }}"
                      selected="selected">
                      {{ order_status.name }}
                    </option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">
                      {{ order_status.name }}
                    </option>
                  {% endif %}
                 {% endfor %}
              </select>
            </div>
            <div class="form-text">
              {{ help_paid_status }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label">{{ entry_refunded_status }}</label>
            <div class="input-group">
               <select name="payment_alliance_refunded_status" class="form-select">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_refunded_status %}
                    <option value="{{ order_status.order_status_id }}"
                            selected="selected">
                      {{ order_status.name }}
                    </option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">
                      {{ order_status.name }}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-text">
              {{ help_refunded_status }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label">{{ entry_refund_fail_status }}</label>
            <div class="input-group">
               <select name="payment_alliance_refund_fail_status" class="form-select">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_refund_fail_status %}
                    <option value="{{ order_status.order_status_id }}"
                            selected="selected">
                      {{ order_status.name }}
                    </option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">
                      {{ order_status.name }}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-text">
              {{ help_refund_fail_status }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label">{{ entry_preauth_status }}</label>
            <div class="input-group">
              <select name="payment_alliance_preauth_status" class="form-select">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_preauth_status %}
                    <option value="{{ order_status.order_status_id }}"
                            selected="selected">
                      {{ order_status.name }}
                    </option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">
                      {{ order_status.name }}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-text">
              {{ help_preauth_status }}
            </div>
          </div>

          <div class="row mb-3">
            <label class="form-label">{{ entry_completion_status }}</label>
            <div class="input-group">
              <select name="payment_alliance_completion_status" class="form-select">
                {% for order_status in order_statuses %}
                  {% if order_status.order_status_id == payment_alliance_completion_status %}
                    <option value="{{ order_status.order_status_id }}"
                            selected="selected">
                      {{ order_status.name }}
                    </option>
                  {% else %}
                    <option value="{{ order_status.order_status_id }}">
                      {{ order_status.name }}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-text">
              {{ help_completion_status }}
            </div>
          </div>

          <br />
        </form>
      </div>
    </div>
  </div>
</div>
<style>
  .admin-statuses{
    padding-bottom: 20px;
  }
</style>
<script>
  function allianceTogglePreAuth(value) {
    var block = document.getElementById('preauth-expdate-block');
    if (block) {
      block.style.display = (value === 'PREAUTH') ? '' : 'none';
    }
  }
  document.addEventListener('DOMContentLoaded', function () {
    var select = document.getElementById('input-hpp-type');
    if (select) {
      allianceTogglePreAuth(select.value);
    }
  });
</script>
{{ footer }}
